    <!-- Assign privileges (resolve IDs via role codes and privilege names) -->
    <changeSet id="023-03-assign-privileges" author="junie">
        <!-- Admin gets all privileges -->
        <sql>
            INSERT INTO t_role_privilege (c_role_id, c_privilege_id)
            SELECT r.c_id, p.c_id
            FROM t_role r CROSS JOIN t_privilege p
            WHERE r.c_code = 'ADMIN';
        </sql>

        <!-- Other roles get a limited set -->
        <sql>
            INSERT INTO t_role_privilege (c_role_id, c_privilege_id)
            SELECT r.c_id, p.c_id
            FROM t_role r
            JOIN t_privilege p ON p.c_name IN ('read:product','read:actor','read:attachment_type','create:attachment','update:attachmen','read:attachment')
            WHERE r.c_code IN ('ACTOR','MANAGER','AGENT','CABINET','COLLEGE','FACTURATION');
        </sql>
    </changeSet>
