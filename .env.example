# Example environment for docker-compose (local or deploy)
# Copy to .env and adjust values

# Runtime profile
PROFILE=prod
BACKEND_PORT=8080

# Database connection
DB_HOST=db
DB_PORT=5432
DB_NAME=optifact_db
DB_USERNAME=optifact
DB_PASSWORD=change_me

# File storage path (mounted volume)
CLAIM_FILE_ROOT_DIR=/data/claims

# Docker images
# For deployment, CI will set IMAGE_TAG to the commit/tag
IMAGE_TAG=latest
# Optional: override registry/namespace (used by docker-compose.deploy.yaml)
REGISTRY=ghcr.io
IMAGE_NAMESPACE=xenonbytesarl
