<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="10092025_0100_create_sequence_table" author="brice.mbiandji">
        <createTable tableName="t_sequence">
            <!-- Base entity fields -->
            <column name="c_id" type="uuid">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="c_created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="c_updated_at" type="timestamp with time zone"/>
            <column name="c_deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- Sequence specific fields -->
            <column name="c_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="c_code" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="c_step" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="c_size" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="c_next" type="numeric(38,0)">
                <constraints nullable="false"/>
            </column>
            <column name="c_prefix" type="varchar(255)"/>
            <column name="c_suffix" type="varchar(255)"/>
            <column name="c_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Indexes for common queries/filters -->
        <createIndex indexName="idx_t_sequence_name" tableName="t_sequence">
            <column name="c_name"/>
        </createIndex>
        <createIndex indexName="idx_t_sequence_code" tableName="t_sequence">
            <column name="c_code"/>
        </createIndex>
        <createIndex indexName="idx_t_sequence_active" tableName="t_sequence">
            <column name="c_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
